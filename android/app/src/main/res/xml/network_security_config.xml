<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTP for localhost (used by model_viewer_plus local server) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- Allow OpenStreetMap tile server (HTTPS but needs explicit trust) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openstreetmap.org</domain>
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
    </domain-config>
    <!-- All other traffic must use HTTPS -->
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
